# API Gateway Configuration
# Get API Gateway ID from: cd ../iac && terraform output api_gateway_id
NEXT_PUBLIC_API_GATEWAY_ID=
NEXT_PUBLIC_API_STAGE=dev

# API Base URL (for LocalStack or AWS)
# LocalStack: http://localhost:4566/restapis
# AWS: https://your-api-id.execute-api.region.amazonaws.com
NEXT_PUBLIC_API_URL=http://localhost:4566/restapis
